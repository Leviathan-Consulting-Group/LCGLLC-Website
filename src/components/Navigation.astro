<nav id="navigation">
  <div class="nav-container">
    <a href="#hero" class="logo-link">
      <img src="/lcg_logo_high_res.png" alt="Leviathan Consulting Group LLC" class="logo" />
      <span class="nav-brand-name">LEVIATHAN CONSULTING GROUP</span>
    </a>

    <button class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Toggle navigation menu">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <div class="nav-links" id="navLinks">
      <a href="#about" class="nav-link">About</a>
      <a href="#services" class="nav-link">Services</a>
      <a href="#product" class="nav-link">Product</a>
      <a href="#why-leviathan" class="nav-link">Why Us</a>
      <a href="#contact" class="btn btn-primary nav-cta">Schedule Call</a>
    </div>
  </div>
</nav>

<script>
  const nav = document.getElementById('navigation');
  const mobileMenuToggle = document.getElementById('mobileMenuToggle');
  const navLinks = document.getElementById('navLinks');
  const navLinkElements = document.querySelectorAll('.nav-link');

  let lastScroll = 0;

  window.addEventListener('scroll', () => {
    const currentScroll = window.pageYOffset;

    if (currentScroll > 100) {
      nav?.classList.add('scrolled');
    } else {
      nav?.classList.remove('scrolled');
    }

    lastScroll = currentScroll;
  });

  mobileMenuToggle?.addEventListener('click', () => {
    navLinks?.classList.toggle('active');
    mobileMenuToggle?.classList.toggle('active');
  });

  navLinkElements.forEach(link => {
    link.addEventListener('click', () => {
      navLinks?.classList.remove('active');
      mobileMenuToggle?.classList.remove('active');
    });
  });

  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      e.preventDefault();
      const target = document.querySelector(this.getAttribute('href') || '');
      if (target) {
        const offsetTop = target.offsetTop - 80;
        window.scrollTo({
          top: offsetTop,
          behavior: 'smooth'
        });
      }
    });
  });
</script>

<style>
