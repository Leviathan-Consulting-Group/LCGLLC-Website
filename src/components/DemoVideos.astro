---
/**
 * Demo videos of the three SMS workflows (GF-5 / #135, feeds GF-6 / #136).
 *
 * Recorded from the admin-ui Simulator against the real workflow engine, so
 * every screen is what a customer actually receives, not a mockup. Source:
 * admin-ui/playwright_tests/demo (see that README to re-record).
 *
 * Each take stops before anything is submitted: Order Parts ends at checkout
 * review, Schedule Service at the estimate.
 */

const videos = [
  {
    id: 'order-parts',
    label: 'Order Parts',
    blurb: 'A customer picks their machine and orders the part, with live prices and stock.',
    length: '0:47',
  },
  {
    id: 'troubleshoot',
    label: 'Troubleshoot Equipment',
    blurb: 'Guided diagnosis, ending in a repair estimate priced from the shop rate.',
    length: '1:05',
  },
  {
    id: 'schedule-service',
    label: 'Schedule Service',
    blurb: 'Books a tune-up, adds pickup, and returns a full estimate with tax.',
    length: '1:16',
  },
];
---

<div class="demos">
  <div class="demo-tabs" role="tablist">
    {videos.map((v, i) => (
      <button
        class:list={['demo-tab', { 'is-active': i === 0 }]}
        data-target={v.id}
        role="tab"
        type="button"
      >
        {v.label}
      </button>
    ))}
  </div>

  <div class="demo-stage">
    {videos.map((v, i) => (
      <figure class:list={['demo-panel', { 'is-active': i === 0 }]} data-panel={v.id}>
        <div class="demo-phone">
          <video
            src={`/videos/${v.id}.mp4`}
            poster={`/videos/${v.id}-poster.jpg`}
            playsinline
            preload="none"
          ></video>
          {/* Cover shown until the take starts: without it the poster frame is
              just a screenshot, and a still of a text thread does not read as
              something you can play. */}
          <button class="demo-cover" type="button" aria-label={`Play the ${v.label} demo`}>
            <span class="demo-cover-play" aria-hidden="true"></span>
            <span class="demo-cover-length">{v.length}</span>
          </button>
        </div>
        <figcaption class="demo-caption">
          <h3>{v.label}</h3>
          <p>{v.blurb}</p>
          <span class="demo-length">{v.length}</span>
        </figcaption>
      </figure>
    ))}
  </div>
</div>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.demo-tab'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.demo-panel'));

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const target = tab.dataset.target;

      // Stop whatever was playing, so switching tabs does not leave audio or a
      // half-played take running out of sight.
      panels.forEach((panel) => {
        const video = panel.querySelector('video');
        if (video && panel.dataset.panel !== target) video.pause();
        panel.classList.toggle('is-active', panel.dataset.panel === target);
      });

      tabs.forEach((t) => t.classList.toggle('is-active', t === tab));
    });
  });

  panels.forEach((panel) => {
    const video = panel.querySelector<HTMLVideoElement>('video');
    const cover = panel.querySelector<HTMLButtonElement>('.demo-cover');
    if (!video || !cover) return;

    cover.addEventListener('click', () => video.play());

    // Native controls are added on first play rather than in the markup: before
    // that they sit on top of the cover, competing with the play button and
    // overlapping the duration badge.
    video.addEventListener('play', () => { video.controls = true; }, { once: true });

    // Driven by the video's own events rather than by the click, so the cover
    // stays in step when the viewer uses the native controls instead.
    video.addEventListener('play', () => panel.classList.add('is-playing'));
    video.addEventListener('ended', () => panel.classList.remove('is-playing'));
  });
</script>

<style>
  .demo-tabs {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .demo-tab {
    padding: 0.7rem 1.5rem;
    border: 2px solid var(--color-gray-bg);
    border-radius: 999px;
    background: var(--color-white);
    font-family: var(--font-family);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-gray-storm);
    cursor: pointer;
    transition: all var(--transition-speed) ease;
  }

  .demo-tab:hover {
    border-color: var(--color-blue-bright);
    color: var(--color-blue-electric);
  }

  .demo-tab.is-active {
    background: var(--color-blue-electric);
    border-color: var(--color-blue-electric);
    color: var(--color-white);
    box-shadow: var(--shadow-md);
  }

  .demo-panel {
    display: none;
    margin: 0;
    gap: 3rem;
    align-items: center;
  }

  .demo-panel.is-active {
    display: grid;
    grid-template-columns: minmax(0, 290px) 1fr;
    animation: demoIn 0.35s ease;
  }

  @keyframes demoIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: none; }
  }

  /* The recording is a portrait phone frame, so it gets a phone-ish shell. */
  .demo-phone {
    position: relative;
    border-radius: 22px;
    overflow: hidden;
    background: var(--color-navy-dark);
    box-shadow: var(--shadow-lg);
    line-height: 0;
  }

  /* The take is a tall portrait frame; cap it so the panel stays a comfortable
     height on a laptop and the caption sits beside it rather than far below. */
  .demo-phone video {
    width: 100%;
    height: auto;
    max-height: 560px;
    display: block;
  }

  /* ── Play cover ────────────────────────────────────────────────── */
  .demo-cover {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border: 0;
    padding: 0;
    cursor: pointer;
    font-family: var(--font-family);
    /* Even wash rather than a vignette: the conversation reads through it, but
       nothing competes with the play button for attention. */
    background: rgba(13, 27, 42, 0.42);
    transition: background var(--transition-speed) ease, opacity 0.35s ease,
      visibility 0.35s ease;
  }

  .demo-cover:hover {
    background: rgba(13, 27, 42, 0.3);
  }

  .demo-panel.is-playing .demo-cover {
    opacity: 0;
    visibility: hidden;
  }

  .demo-cover-play {
    width: 76px;
    height: 76px;
    border-radius: 50%;
    background: var(--color-blue-electric);
    /* A ring of its own colour lifts the button off whatever text sits behind
       it, so it never reads as part of the conversation. */
    box-shadow:
      0 0 0 10px rgba(0, 136, 204, 0.25),
      0 12px 32px rgba(0, 0, 0, 0.45);
    display: grid;
    place-items: center;
    transition: transform var(--transition-speed) ease, background var(--transition-speed) ease,
      box-shadow var(--transition-speed) ease;
  }

  /* Triangle from a border, so the button needs no icon asset. */
  .demo-cover-play::after {
    content: '';
    border-style: solid;
    border-width: 13px 0 13px 21px;
    border-color: transparent transparent transparent var(--color-white);
    margin-left: 5px;
  }

  .demo-cover:hover .demo-cover-play,
  .demo-cover:focus-visible .demo-cover-play {
    transform: scale(1.08);
    background: var(--color-blue-bright);
    box-shadow:
      0 0 0 14px rgba(0, 170, 255, 0.25),
      0 12px 32px rgba(0, 0, 0, 0.45);
  }

  .demo-cover:focus-visible {
    outline: 3px solid var(--color-blue-bright);
    outline-offset: -3px;
  }

  /* Bottom corner, out of the way of the thread and of the play button. */
  .demo-cover-length {
    position: absolute;
    right: 0.9rem;
    bottom: 1.1rem;
    color: var(--color-white);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    background: rgba(13, 27, 42, 0.8);
  }

  .demo-caption h3 {
    margin-bottom: 0.75rem;
  }

  .demo-caption p {
    color: var(--color-gray-storm);
    font-size: 1.1rem;
    margin-bottom: 1rem;
  }

  .demo-length {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-blue-electric);
  }

  @media (max-width: 900px) {
    .demo-panel.is-active {
      grid-template-columns: 1fr;
      gap: 1.75rem;
      justify-items: center;
      text-align: center;
    }

    .demo-phone {
      max-width: 320px;
    }
  }
</style>
