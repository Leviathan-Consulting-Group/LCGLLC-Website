---
/**
 * Dealer self-onboarding wizard: CLICKABLE PREVIEW (GF-7 / #137).
 *
 * A front-end prototype of the flow specced in the Dealer Self-Onboarding epic
 * (US-ONB-01…15). Nothing here talks to a backend: no account is created, no
 * Lizzy credentials are sent anywhere, no dealer record is written. It exists so
 * the flow can be walked through and argued about before any of it is built.
 *
 * Structure follows the three stages Jonathan set out:
 *   A. Number Porting        -> step "phone"
 *   B. Minimum to Enroll     -> steps "account", "dealership", "lizzy", "import"
 *   C. Complete Full Onboarding -> offered at the end as the "full" path
 *
 * The step list is deliberately shown up front with a time estimate. His
 * requirement from the 2026-06-24 call was that dealers must never feel trapped
 * mid-flow.
 */

const steps = [
  {
    id: 'account',
    stage: 'Account',
    title: 'Create your account',
    blurb: 'So you can save your progress and come back later.',
  },
  {
    id: 'dealership',
    stage: 'Your business',
    title: 'Tell us about your dealership',
    blurb: 'Name, hours, and the brands you sell and service.',
  },
  {
    id: 'phone',
    stage: 'Your number',
    title: 'Add texting to your phone number',
    blurb: 'Keep the number your customers already call.',
  },
  {
    id: 'lizzy',
    stage: 'Your data',
    title: 'Connect your Lizzy account',
    blurb: 'So we can bring in your customers and their equipment.',
  },
  {
    id: 'import',
    stage: 'Your data',
    title: 'Import customers & equipment',
    blurb: 'Runs in the background, usually a few minutes.',
  },
  {
    id: 'finish',
    stage: 'Go live',
    title: 'Choose how you start',
    blurb: 'Go live on our defaults, or fine-tune everything first.',
  },
  {
    id: 'customize',
    stage: 'Optional',
    title: 'Make it yours',
    blurb: 'Only shown if you choose to fine-tune.',
    optional: true,
  },
];
---

<div class="wizard" id="wizard" data-total={steps.length}>
  <!-- Up-front overview: every step visible before the dealer commits -->
  <ol class="wizard-steps" id="wizardSteps">
    {steps.map((step, i) => (
      <li class:list={['wizard-step', { 'is-optional': step.optional }]} data-index={i} data-step-id={step.id}>
        <span class="step-marker">{i + 1}</span>
        <span class="step-text">
          <span class="step-stage">{step.stage}</span>
          <span class="step-title">{step.title}</span>
        </span>
      </li>
    ))}
  </ol>

  <div class="wizard-panel">
    <div class="wizard-progress">
      <div class="wizard-progress-bar"><span id="progressFill"></span></div>
      <p class="wizard-progress-label">
        Step <strong id="progressNow">1</strong> of <span id="progressTotal">{steps.length - 1}</span>
        <span class="wizard-progress-time">· about 20 minutes in total</span>
      </p>
    </div>

    {/* ── Step 1: account ─────────────────────────────────────────── */}
    <section class="wizard-card is-active" data-step="account">
      <h3>Create your account</h3>
      <p class="wizard-lede">You can stop at any point and pick up where you left off.</p>
      <div class="field-grid">
        <div class="form-group">
          <label for="ob-email">Work email</label>
          <input type="email" id="ob-email" placeholder="you@yourdealership.com" />
        </div>
        <div class="form-group">
          <label for="ob-password">Password</label>
          <input type="password" id="ob-password" placeholder="At least 12 characters" />
        </div>
      </div>
    </section>

    {/* ── Step 2: dealership details + brands ─────────────────────── */}
    <section class="wizard-card" data-step="dealership">
      <h3>Tell us about your dealership</h3>
      <p class="wizard-lede">This is what your customers see when the agent answers them.</p>
      <div class="field-grid">
        <div class="form-group">
          <label for="ob-biz">Business name</label>
          <input type="text" id="ob-biz" placeholder="Carl's Mower &amp; Saw" />
        </div>
        <div class="form-group">
          <label for="ob-hours">Hours</label>
          <input type="text" id="ob-hours" placeholder="Mon-Fri 8-5, Sat 9-2" />
        </div>
      </div>
      <p class="field-legend">Brands you sell and service</p>
      <div class="chip-row">
        {['STIHL', 'Honda', 'Toro', 'Husqvarna', 'Echo', 'Ariens', 'Scag', 'Exmark'].map((brand) => (
          <label class="chip">
            <input type="checkbox" />
            <span>{brand}</span>
          </label>
        ))}
      </div>
      <p class="wizard-note">
        We use this to load the parts catalogue for your brands and to match our repair-pricing
        trees against what you actually sell.
      </p>
    </section>

    {/* ── Step 3: phone / porting (Stage A) ───────────────────────── */}
    <section class="wizard-card" data-step="phone">
      <h3>Add texting to your phone number</h3>
      <p class="wizard-lede">
        Your customers keep calling the same number. We add the ability to text it, and your
        voice service is untouched.
      </p>
      <div class="field-grid">
        <div class="form-group">
          <label for="ob-phone">Your customer-facing number</label>
          <input type="tel" id="ob-phone" placeholder="(360) 555-0134" />
        </div>
        <div class="form-group">
          <label for="ob-carrier">Current phone provider</label>
          <input type="text" id="ob-carrier" placeholder="e.g. Comcast Business" />
        </div>
      </div>
      <div class="notice">
        <strong>This part takes a few days, and it runs in the background.</strong>
        <p>
          Mobile carriers review every business that wants to send texts. We prepare and submit
          everything for you. You can keep setting up while the review is pending, and we email you
          the moment it clears.
        </p>
      </div>
    </section>

    {/* ── Step 4: connect Lizzy ───────────────────────────────────── */}
    <section class="wizard-card" data-step="lizzy">
      <h3>Connect your Lizzy account</h3>
      <p class="wizard-lede">
        This lets the agent recognise your customers and know what equipment they own.
      </p>
      <div class="field-grid">
        <div class="form-group">
          <label for="ob-lizzy-url">Your Lizzy address</label>
          <input type="text" id="ob-lizzy-url" placeholder="https://east.nizex.com" />
        </div>
        <div class="form-group">
          <label for="ob-lizzy-user">Lizzy username</label>
          <input type="text" id="ob-lizzy-user" placeholder="API user" />
        </div>
      </div>
      <label class="consent">
        <input type="checkbox" />
        <span>
          I authorise Leviathan Consulting Group to sign in to my Lizzy account and import my
          customer and equipment records.
        </span>
      </label>
      <p class="wizard-note">
        We check the connection straight away and tell you if the account is missing a permission we
        need, rather than letting you find out later when an order fails.
      </p>
    </section>

    {/* ── Step 5: import (progress illustration) ──────────────────── */}
    <section class="wizard-card" data-step="import">
      <h3>Importing your customers &amp; equipment</h3>
      <p class="wizard-lede">You can leave this page. We will email you when it finishes.</p>
      <ul class="import-list">
        <li class="import-row is-done">
          <span class="import-tick">✓</span>
          <span class="import-label">Customers</span>
          <span class="import-count">1,148 found</span>
        </li>
        <li class="import-row is-done">
          <span class="import-tick">✓</span>
          <span class="import-label">Equipment records</span>
          <span class="import-count">2,731 matched</span>
        </li>
        <li class="import-row is-running">
          <span class="import-tick">·</span>
          <span class="import-label">Parts catalogue for your brands</span>
          <span class="import-count">in progress</span>
        </li>
      </ul>
      <p class="wizard-note">
        Anything we cannot match is listed for you afterwards, so nothing disappears quietly.
      </p>
    </section>

    {/* ── Step 6: fast vs full ────────────────────────────────────── */}
    <section class="wizard-card" data-step="finish">
      <h3>Choose how you start</h3>
      <p class="wizard-lede">
        You can switch between these at any time. Nothing here is permanent.
      </p>
      {/* Radio inputs rather than click handlers on divs: the choice is keyboard
          reachable and announced as a choice, with no extra scripting. */}
      <div class="path-grid">
        <label class="path-card">
          <input type="radio" name="onboarding-path" value="fast" checked />
          <span class="path-flag">Fastest</span>
          <span class="path-check" aria-hidden="true"></span>
          <h4>Go live on our defaults</h4>
          <p>
            Standard repair-pricing, standard welcome message, our parts recommendations. You are
            ready as soon as the carrier review clears.
          </p>
          <span class="path-meta">Nothing more to do</span>
        </label>
        <label class="path-card">
          <input type="radio" name="onboarding-path" value="full" />
          <span class="path-check" aria-hidden="true"></span>
          <h4>Fine-tune everything first</h4>
          <p>
            Load your own repair-pricing trees, set pickup and delivery rates, and write your own
            welcome message before your customers hear from you.
          </p>
          <span class="path-meta">About 15 minutes more</span>
        </label>
      </div>
    </section>

    {/* Stage C, reached only from the "fine-tune" path */}
    <section class="wizard-card" data-step="customize">
      <h3>Make it yours</h3>
      <p class="wizard-lede">
        Each of these has a sensible default already in place, so you can set what matters and skip
        the rest.
      </p>
      <ul class="tune-list">
        <li class="tune-row">
          <span class="tune-text">
            <strong>Your own repair pricing</strong>
            Upload your labour times and rates instead of using our standard tree.
          </span>
          <span class="tune-state">Using ours</span>
        </li>
        <li class="tune-row">
          <span class="tune-text">
            <strong>Pickup and delivery</strong>
            Offer collection, and set what you charge for it.
          </span>
          <span class="tune-state">Not offered</span>
        </li>
        <li class="tune-row">
          <span class="tune-text">
            <strong>Parts shipping rates</strong>
            What customers pay to have parts sent out.
          </span>
          <span class="tune-state">Flat rate</span>
        </li>
        <li class="tune-row">
          <span class="tune-text">
            <strong>Your welcome message</strong>
            The first text your customers receive from you.
          </span>
          <span class="tune-state">Standard</span>
        </li>
      </ul>
      <p class="wizard-note">
        You can change any of this later from your dealer account, so nothing here locks you in.
      </p>
    </section>

    {/* Terminal state: no navigation out, the wizard is finished */}
    <section class="wizard-card wizard-done" data-step="done">
      <span class="done-mark" aria-hidden="true"></span>
      <h3>You are all set</h3>
      <p class="wizard-lede" id="doneLede">
        Your dealership is configured and your customer list is loaded.
      </p>
      <ol class="done-next">
        <li>
          <strong>We submit your number for carrier review.</strong>
          This is the part that takes a few days. We email you the moment it clears.
        </li>
        <li>
          <strong>Your customers get one invitation each.</strong>
          A single text explaining the service, asking them to reply YES. Nobody is messaged without
          opting in.
        </li>
        <li>
          <strong>The agent starts answering.</strong>
          Parts, service bookings, and troubleshooting, on the number they already call.
        </li>
      </ol>
      <button type="button" class="btn btn-secondary" id="wizardRestart">Start over</button>
    </section>

    <div class="wizard-actions">
      <button type="button" class="btn btn-secondary" id="wizardBack" disabled>Back</button>
      <button type="button" class="btn btn-primary" id="wizardNext">Continue</button>
    </div>
  </div>
</div>

<script>
  const wizard = document.getElementById('wizard');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.wizard-card'));
  const stepItems = Array.from(document.querySelectorAll<HTMLElement>('.wizard-step'));
  const backBtn = document.getElementById('wizardBack') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('wizardNext') as HTMLButtonElement | null;
  const actions = document.querySelector<HTMLElement>('.wizard-actions');
  const progress = document.querySelector<HTMLElement>('.wizard-progress');
  const progressFill = document.getElementById('progressFill');
  const progressNow = document.getElementById('progressNow');
  const progressTotal = document.getElementById('progressTotal');
  const doneLede = document.getElementById('doneLede');
  const restartBtn = document.getElementById('wizardRestart');

  /** Which path the dealer picked on the "Choose how you start" step. */
  function chosenPath(): string {
    return (
      document.querySelector<HTMLInputElement>('input[name="onboarding-path"]:checked')?.value ??
      'fast'
    );
  }

  /**
   * The steps actually in play. "customize" belongs to the full path only, so on
   * the fast path it is dropped from the sequence, from the step list, and from
   * the "step N of M" count rather than being shown as a step that gets skipped.
   */
  function activeSteps(): string[] {
    const ids = cards.map((c) => c.dataset.step!).filter((id) => id !== 'done');
    return chosenPath() === 'full' ? ids : ids.filter((id) => id !== 'customize');
  }

  let currentId = cards[0]?.dataset.step ?? 'account';

  function render() {
    const steps = activeSteps();
    const isDone = currentId === 'done';
    const index = steps.indexOf(currentId);

    cards.forEach((card) => card.classList.toggle('is-active', card.dataset.step === currentId));

    stepItems.forEach((item) => {
      const id = item.dataset.stepId!;
      const pos = steps.indexOf(id);
      const inPath = pos !== -1;
      item.classList.toggle('is-hidden', !inPath);
      item.classList.toggle('is-current', !isDone && id === currentId);
      item.classList.toggle('is-done', isDone || (inPath && pos < index));
    });

    // The progress bar and the Back/Continue pair have no meaning once the
    // wizard has finished, so the terminal card owns the panel on its own.
    progress?.classList.toggle('is-hidden', isDone);
    actions?.classList.toggle('is-hidden', isDone);

    if (!isDone) {
      if (progressFill) progressFill.style.width = `${((index + 1) / steps.length) * 100}%`;
      if (progressNow) progressNow.textContent = String(index + 1);
      if (progressTotal) progressTotal.textContent = String(steps.length);
      if (backBtn) backBtn.disabled = index === 0;
      if (nextBtn) {
        nextBtn.textContent =
          currentId === 'finish'
            ? chosenPath() === 'full'
              ? 'Continue to setup'
              : 'Go live'
            : currentId === 'customize'
              ? 'Go live'
              : 'Continue';
      }
    }

    if (isDone && doneLede) {
      doneLede.textContent =
        chosenPath() === 'full'
          ? 'Your dealership is configured the way you set it up, and your customer list is loaded.'
          : 'Your dealership is configured on our standard settings, and your customer list is loaded.';
    }

    if (window.innerWidth < 900) {
      wizard?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  function go(direction: 1 | -1) {
    const steps = activeSteps();

    if (currentId === 'done') {
      if (direction === -1) currentId = steps[steps.length - 1];
      render();
      return;
    }

    const index = steps.indexOf(currentId);
    const target = index + direction;

    if (target < 0) return;
    currentId = target >= steps.length ? 'done' : steps[target];
    render();
  }

  nextBtn?.addEventListener('click', () => go(1));
  backBtn?.addEventListener('click', () => go(-1));

  restartBtn?.addEventListener('click', () => {
    currentId = 'account';
    render();
    wizard?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  document
    .querySelectorAll<HTMLInputElement>('input[name="onboarding-path"]')
    .forEach((radio) => radio.addEventListener('change', render));

  // The overview doubles as navigation: any step already seen can be revisited.
  stepItems.forEach((item) => {
    item.addEventListener('click', () => {
      const steps = activeSteps();
      const pos = steps.indexOf(item.dataset.stepId!);
      const here = steps.indexOf(currentId);
      if (pos !== -1 && (currentId === 'done' || pos <= here)) {
        currentId = steps[pos];
        render();
      }
    });
  });

  render();
</script>

<style>
  .wizard {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 3rem;
    align-items: start;
  }

  /* ── Step overview ─────────────────────────────────────────────── */
  .wizard-steps {
    list-style: none;
    padding: 0;
    margin: 0;
    position: sticky;
    top: 120px;
  }

  .wizard-step {
    display: flex;
    gap: 1rem;
    padding: 0.85rem 0;
    align-items: flex-start;
    opacity: 0.5;
    transition: opacity var(--transition-speed) ease;
  }

  .wizard-step.is-current,
  .wizard-step.is-done {
    opacity: 1;
  }

  .wizard-step.is-done,
  .wizard-step.is-current {
    cursor: pointer;
  }

  .step-marker {
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 0.85rem;
    font-weight: 700;
    background: var(--color-gray-bg);
    color: var(--color-gray-storm);
    border: 2px solid transparent;
    transition: all var(--transition-speed) ease;
  }

  .wizard-step.is-current .step-marker {
    background: var(--color-blue-electric);
    color: var(--color-white);
    box-shadow: 0 0 0 4px rgba(0, 136, 204, 0.15);
  }

  .wizard-step.is-done .step-marker {
    background: var(--color-white);
    color: var(--color-blue-electric);
    border-color: var(--color-blue-electric);
  }

  .step-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .step-stage {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gray-light);
  }

  .step-title {
    font-weight: 600;
    color: var(--color-navy);
    line-height: 1.35;
  }

  /* ── Panel ─────────────────────────────────────────────────────── */
  .wizard-panel {
    background: var(--color-white);
    border-radius: var(--border-radius);
    box-shadow: var(--shadow-lg);
    padding: 2.5rem;
  }

  .wizard-progress {
    margin-bottom: 2rem;
  }

  .wizard-progress-bar {
    height: 6px;
    border-radius: 999px;
    background: var(--color-gray-bg);
    overflow: hidden;
  }

  .wizard-progress-bar span {
    display: block;
    height: 100%;
    width: 16%;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--color-blue-electric), var(--color-blue-bright));
    transition: width 0.4s ease;
  }

  .wizard-progress-label {
    margin: 0.65rem 0 0;
    font-size: 0.9rem;
    color: var(--color-gray-storm);
  }

  .wizard-progress-time {
    color: var(--color-gray-light);
  }

  .wizard-card {
    display: none;
  }

  .wizard-card.is-active {
    display: block;
    animation: cardIn 0.35s ease;
  }

  @keyframes cardIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }

  .wizard-card h3 {
    margin-bottom: 0.5rem;
  }

  .wizard-lede {
    color: var(--color-gray-storm);
    margin-bottom: 1.75rem;
  }

  .field-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }

  /* Mirrors the contact form on the home page so the two read as one product. */
  .form-group {
    display: flex;
    flex-direction: column;
  }

  .form-group label {
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--color-navy);
  }

  .form-group input {
    padding: 0.75rem;
    border: 2px solid var(--color-gray-bg);
    border-radius: 6px;
    font-family: var(--font-family);
    font-size: 1rem;
    transition: border-color var(--transition-speed) ease;
  }

  .form-group input:focus {
    outline: none;
    border-color: var(--color-blue-electric);
  }

  .field-legend {
    font-weight: 600;
    color: var(--color-navy);
    margin-bottom: 0.75rem;
  }

  .chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border: 2px solid var(--color-gray-bg);
    border-radius: 999px;
    cursor: pointer;
    font-weight: 500;
    transition: all var(--transition-speed) ease;
  }

  .chip:hover {
    border-color: var(--color-blue-bright);
  }

  .chip:has(input:checked) {
    border-color: var(--color-blue-electric);
    background: rgba(0, 136, 204, 0.08);
    color: var(--color-blue-electric);
  }

  .chip input {
    accent-color: var(--color-blue-electric);
  }

  .consent {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 1rem;
    background: var(--color-gray-bg);
    border-radius: 6px;
    margin-bottom: 1.25rem;
    cursor: pointer;
  }

  .consent input {
    margin-top: 0.25rem;
    accent-color: var(--color-blue-electric);
  }

  .wizard-note {
    font-size: 0.9rem;
    color: var(--color-gray-storm);
    margin: 0;
  }

  .notice {
    border-left: 4px solid var(--color-blue-electric);
    background: var(--color-gray-bg);
    padding: 1.25rem 1.5rem;
    border-radius: 0 6px 6px 0;
  }

  .notice strong {
    color: var(--color-navy);
    display: block;
    margin-bottom: 0.4rem;
  }

  .notice p {
    margin: 0;
    color: var(--color-gray-storm);
    font-size: 0.95rem;
  }

  /* ── Import illustration ───────────────────────────────────────── */
  .import-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .import-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-radius: 6px;
    background: var(--color-gray-bg);
  }

  .import-tick {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: 0.85rem;
    flex-shrink: 0;
  }

  .import-row.is-done .import-tick {
    background: var(--color-blue-electric);
    color: var(--color-white);
  }

  .import-row.is-running .import-tick {
    background: var(--color-white);
    color: var(--color-blue-electric);
    border: 2px solid var(--color-blue-electric);
    animation: pulse 1.4s ease-in-out infinite;
  }

  @keyframes pulse {
    50% { opacity: 0.35; }
  }

  .import-label {
    font-weight: 600;
    color: var(--color-navy);
    flex: 1;
  }

  .import-count {
    color: var(--color-gray-storm);
    font-size: 0.9rem;
  }

  /* ── Fast vs full ──────────────────────────────────────────────── */
  .path-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .path-card {
    position: relative;
