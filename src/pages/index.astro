				<a href="/LizzyConnect_Terms_and_Conditions.pdf" target="_blank" rel="noopener noreferrer">Terms &amp; Conditions</a>
				<span class="legal-divider">|</span>
				<a href="/LizzyConnect_Privacy_Policy.pdf" target="_blank" rel="noopener noreferrer">Privacy Policy</a>
			</div>
		</div>
	</section>

